# IronPath AI Squat Form Coach - Environment Variables

# Optional: LLM Assessment Provider ("deterministic" | "gemini" | "openai")
# If unconfigured or API key missing, pipeline automatically falls back to deterministic grounded rules engine
LLM_PROVIDER=deterministic

# Optional API Keys for LLM Evaluation Engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# YOLO Pose Model ("yolov8s-pose.pt" | "yolov8n-pose.pt")
YOLO_POSE_MODEL=yolov8s-pose.pt

# Streamlit Port & Server Config
PORT=8501
HOST=0.0.0.0
