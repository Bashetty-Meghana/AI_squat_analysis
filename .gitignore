output/*.mp4
output/*.mov
output/*.avi
output/*.webm
output/job_*
output/uploads/

# Environment variables & secrets
.env
.env.local

# Virtual environments
venv/
env/
ENV/

# System and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
temp/
